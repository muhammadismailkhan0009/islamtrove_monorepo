# Optional public runtime settings. Never commit real credentials.
ISLAMTROVE_QURAN_API_BASE_URL=https://api.alquran.cloud/v1
ISLAMTROVE_HTTP_TIMEOUT_SECONDS=12
# On the server, configure ISLAMTROVE_ADMIN_CODE as a Woodpecker repository
# secret instead of placing the real value in this file or the Git repository.
# ISLAMTROVE_ADMIN_CODE=your-private-strong-password
# Optional local review/grouping directory; production uses /data/reviews.
ISLAMTROVE_REVIEW_DATA_DIR=
