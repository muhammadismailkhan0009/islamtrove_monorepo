  "ports": [
    {
      "id": "quran-catalog",
      "name": "Quran Catalog",
      "description": "Read Surah metadata and Ayah counts",
      "operations": {
        "listSurahs": {
          "description": "List available Surahs with display metadata and Ayah counts"
        }
      },
      "implementationRoots": [
        "src/application/ports/quran-catalog"
      ]
    },
    {
      "id": "audio-options",
      "name": "Audio Options",
      "description": "List available reciters and audio-translation languages",
      "operations": {
        "listAudioOptions": {
          "description": "List voices and available spoken translation languages"
        }
      },
      "implementationRoots": [
        "src/application/ports/audio-options"
      ]
    },
    {
      "id": "audio-media",
      "name": "Audio Media",
      "description": "Legacy combined audio contract retained for compatibility; the listening studio now uses QUL continuous recitation and independent translation-audio ports.",
      "operations": {
        "getSurahAudio": {
          "description": "Resolve chosen reciter and translation for an entire Surah, preserving Ayah indexes"
        }
      },
      "implementationRoots": [
        "src/application/ports/audio-media"
      ]
    },
    {
      "id": "verse-preview",
      "name": "Verse Reading Text",
      "description": "Retrieve Arabic verse text and translated reading text separately from spoken audio",
      "operations": {
        "getSurahVerses": {
          "description": "Retrieve a Surah’s Arabic text and selected language translations"
        }
      },
      "implementationRoots": [
        "src/application/ports/verse-preview"
      ]
    },
    {
      "id": "media-cache",
      "name": "Browser Media Cache",
      "description": "High-capacity in-memory audio bytes, with request coalescing and LRU eviction",
      "operations": {
        "get": {
          "description": "Download or reuse audio binary Blob bytes from browser-session memory"
        }
      },
      "implementationRoots": [
        "src/application/ports/media-cache"
      ]
    },
    {
      "id": "continuous-recitation",
      "name": "QUL Continuous Arabic Recitation",
      "description": "Trusted Ayah timing metadata and one full-Surah audio source (Mujawwad)",
      "operations": {
        "getSurah": {
          "description": "Fetch verified contiguous per-Ayah millisecond boundaries"
        }
      },
      "implementationRoots": [
        "src/application/ports/continuous-recitation"
      ]
    },
    {
      "id": "streaming-source",
      "name": "Progressive Streaming Source",
      "description": "Resolve a QUL continuous Surah recording to a progressive media URL; production uses an approved range proxy and persistent service-worker cache",
      "operations": {
        "resolve": {
          "description": "Resolve original CDN URL to a streamable media endpoint without full-file download"
        }
      },
      "implementationRoots": [
        "src/application/ports/streaming-source"
      ]
    },
    {
      "id": "translation-audio",
      "name": "Independent Spoken Translation Audio",
      "description": "Resolve a single translated spoken language for a Surah, without requiring Arabic audio. A failure only skips the affected translation.",
      "operations": {
        "getSurah": {
          "description": "Fetch language-specific Ayah media and explicitly unavailable Ayahs on demand"
        }
      },
      "implementationRoots": [
        "src/application/ports/translation-audio"
      ]
    },
    {
      "id": "alignment-review",
      "name": "Admin Ayah Alignment Review",
      "operations": {
        "list": {
          "description": "Read per-Surah timing review flags and verified outcomes"
        },
        "authenticate": {
          "description": "Authenticate a reviewer (design preview mock only; real backend pending)"
        },
        "submit": {
          "description": "Submit Ayah timing verification or boundary correction (design preview mock only)"
        }
      },
      "description": "Mock-only admin authorization and audio boundary verification UI prototype. Production adapter is disabled until the backend review service is implemented.",
      "implementationRoots": [
        "src/application/ports/alignment-review"
      ]
    }
  ],
